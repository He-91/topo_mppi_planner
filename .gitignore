# ROS / catkin build products
/build/
/devel/
/.catkin_tools/
/.catkin_workspace
/logs/

# Nested reference-package build products
packages/**/build/
packages/**/devel/
packages/**/.catkin_tools/
packages/**/logs/

# CMake generated files
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
CTestTestfile.cmake
CTestConfiguration.ini
CTestCustom.cmake

# Python cache
__pycache__/
*.py[cod]
*.pyo

# IDE / editor
/.vscode/
/.idea/
*.sublime-*
*.swp
*~

# Local documentation and private notes
/doc/
/.local_docs/
/PRIVATE_REAL_RESULTS.txt
/TEACHING_TARGET_RESULTS_TOPO_MPPI.md
/PAUSED_TASK_STATE_*.md
/review_action_plan.md
/REVIEW_ACTION_INFO_SUPPLEMENT.md
/AI_ALGORITHM_OPTIMIZATION_ROADMAP.md
/*.md
!/README.md

# Benchmark and simulation outputs
src/benchmark/results/*
!src/benchmark/results/.gitkeep
*.bag
*.log
*.out
*.tmp
*.info

# Archives and generated documents
*.zip
*.tar
*.tar.gz
*.pdf

