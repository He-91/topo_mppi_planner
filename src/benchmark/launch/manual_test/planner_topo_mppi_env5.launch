<!--
  Topo-MPPI 规划器 — 环境5: Narrow Perlin Maze (40x16m)
  窄通道 Perlin 迷宫，Y 维度 16m，RViz 流畅可视化
  路线: (-16,0,1) -> (16,0,1) -> (-16,0,1) [往返穿越迷宫]
  Topo-MPPI planning_horizon=9.0
-->
<launch>
  <include file="$(find ddo_planner)/launch/advanced_param.xml">
    <arg name="map_size_x_" value="40.0"/>
    <arg name="map_size_y_" value="16.0"/>
    <arg name="map_size_z_" value="3.0"/>
    <arg name="odometry_topic" value="/visual_slam/odom"/>
    <arg name="camera_pose_topic" value="/pcl_render_node/camera_pose"/>
    <arg name="depth_topic" value="/pcl_render_node/depth"/>
    <arg name="cloud_topic" value="/pcl_render_node/cloud"/>
    <arg name="cx" value="321.04638671875"/>
    <arg name="cy" value="243.44969177246094"/>
    <arg name="fx" value="387.229248046875"/>
    <arg name="fy" value="387.229248046875"/>
    <arg name="max_vel" value="2.0"/>
    <arg name="max_acc" value="2.5"/>
    <arg name="planning_horizon" value="9.0"/>
    <arg name="planning_timing_log_enabled" value="true"/>
    <arg name="planning_timing_log_path" value="/tmp/topo_mppi_env5_planning_timing.csv"/>
    <arg name="candidate_quality_log_enabled" value="true"/>
    <arg name="candidate_quality_log_path" value="/tmp/topo_mppi_env5_candidate_quality.csv"/>
    <arg name="topo_grid_seed_enabled" value="true"/>
    <arg name="topo_grid_seed_resolution" value="0.3"/>
    <arg name="topo_grid_seed_max_paths" value="4"/>
    <arg name="topo_grid_seed_lateral_scale" value="1.4"/>
    <arg name="topo_grid_seed_clearance" value="0.06"/>
    <arg name="topo_grid_seed_clearance_cost_weight" value="0.75"/>
    <arg name="topo_grid_seed_reuse_penalty" value="12.0"/>
    <arg name="static_scene_preserve_safe_seed" value="true"/>
    <arg name="static_scene_preserve_min_clearance" value="0.25"/>
    <arg name="mppi_gpu_nominal_max_vel" value="2.4"/>
    <arg name="mppi_gpu_nominal_max_acc" value="2.5"/>
    <arg name="flight_type" value="2"/>
    <arg name="point_num" value="3"/>
    <arg name="point0_x" value="-16.0"/>
    <arg name="point0_y" value="0.0"/>
    <arg name="point0_z" value="1.0"/>
    <arg name="point1_x" value="16.0"/>
    <arg name="point1_y" value="0.0"/>
    <arg name="point1_z" value="1.0"/>
    <arg name="point2_x" value="-16.0"/>
    <arg name="point2_y" value="0.0"/>
    <arg name="point2_z" value="1.0"/>
    <!-- Unused but required by advanced_param.xml -->
    <arg name="point3_x" value="0.0"/>
    <arg name="point3_y" value="0.0"/>
    <arg name="point3_z" value="1.0"/>
    <arg name="point4_x" value="0.0"/>
    <arg name="point4_y" value="0.0"/>
    <arg name="point4_z" value="1.0"/>
  </include>

  <node pkg="ddo_planner" name="traj_server" type="traj_server" output="screen">
    <remap from="/position_cmd" to="planning/pos_cmd"/>
    <remap from="/odom_world" to="/visual_slam/odom"/>
    <param name="traj_server/time_forward" value="1.0" type="double"/>
  </node>

  <node pkg="waypoint_generator" name="waypoint_generator" type="waypoint_generator" output="screen">
    <remap from="~odom" to="/visual_slam/odom"/>
    <remap from="~goal" to="/move_base_simple/goal"/>
    <remap from="~traj_start_trigger" to="/traj_start_trigger"/>
    <param name="waypoint_type" value="manual-lonely-waypoint"/>
  </node>
</launch>
