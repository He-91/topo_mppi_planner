<?xml version="1.0"?>
<package format="2">
  <name>ddo_benchmark</name>
  <version>1.0.0</version>
  <description>Benchmark framework for comparing Topo-MPPI against EGO-Planner, Fast-Planner, and TGK-Planner</description>
  <maintainer email="dev@todo.todo">developer</maintainer>
  <license>MIT</license>

  <buildtool_depend>catkin</buildtool_depend>

  <depend>roscpp</depend>
  <depend>std_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>tf</depend>
  <depend>message_generation</depend>
  <depend>message_runtime</depend>
  <depend>quadrotor_msgs</depend>
  <depend>pcl_conversions</depend>
  <depend>ddo_planner</depend>

  <export>
  </export>
</package>
